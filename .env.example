# Server
PORT=3000
DATABASE_PATH=./data/seo-engine.db
SETUP_SECRET=change-me-to-a-random-string
CORS_ORIGIN=*

# Knowledge base (path to .md files)
KB_PATH=./knowledge

# Era / OhMyGEO (AEO keyword source — get from https://new.era.shopping → Settings → API Keys)
ERA_AI_API_KEY=omg_...
# Get your brand_id by calling `listBrands()` from src/services/era.ts once
ERA_AI_BRAND_ID=

# Claude (article generation, grounding, competitor web-search research)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (gpt-image-2 thumbnail generation - optional, articles work without)
OPENAI_API_KEY=sk-...

# Cloudflare R2 (asset storage - optional, articles work without)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=seo-engine-assets
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# Screenshot API (optional - screenshotone.com)
SCREENSHOT_API_KEY=

# Slack notifications (optional)
SLACK_WEBHOOK_URL=
